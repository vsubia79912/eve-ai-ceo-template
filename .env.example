# Default starter mode. Use a strong value (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Optional production mode. Configure every value in this section to switch
# from browser storage/password auth to Neon, Upstash, and Sign in with Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=

# Autonomous company runtime. Vercel OIDC is preferred and automatically
# provided by linked projects; a static Gateway key is an optional fallback.
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=

# Prefer a short-lived, least-privilege GitHub App installation token. A PAT is
# accepted for local prototyping only. Required permissions: Contents read/write
# and Pull requests read/write for only the selected repositories.
GITHUB_APP_INSTALLATION_TOKEN=
GITHUB_TOKEN=

# Central model overrides (all IDs are Vercel AI Gateway model IDs).
CEO_MODEL=openai/gpt-5.4
ENGINEERING_MODEL=openai/gpt-5.4
REVIEWER_MODEL=openai/gpt-5.4
CODEX_MODEL=openai/gpt-5.4

# Bounded autonomous loops and wall-clock runtime.
MAX_REPAIR_LOOPS=3
MAX_REVIEW_LOOPS=2
MAX_CODEX_FOLLOWUPS=8
MAX_TASK_RUNTIME_MINUTES=120
